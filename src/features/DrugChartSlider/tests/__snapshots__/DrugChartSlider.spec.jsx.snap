                        class="cds--time-picker__input-field cds--text-input"
                        id="time-selector"
                        maxlength="5"
                        pattern="(1[012]|[1-9]):[0-5][0-9](\\s)?"
                        placeholder="hh:mm"
                        style="width: 70%; padding: 0px 0px 0px 1rem;"
                        type="text"
                        value="03:00"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="instructions"
        >
          <div
            class="cds--form-item instruction"
          >
            <div
              class="cds--text-area__label-wrapper"
            >
              <label
                class="cds--label cds--label--disabled"
                dir="auto"
              >
                Instruction
              </label>
            </div>
            <div
              class="cds--text-area__wrapper cds--text-area__wrapper--readonly"
            >
              <textarea
                aria-invalid="false"
                aria-readonly="true"
                class="cds--text-area"
                disabled=""
                placeholder=""
                readonly=""
                rows="1"
                style="width: 100%;"
                type="text"
              />
              <span
                aria-atomic="true"
                aria-live="assertive"
                class="cds--text-area__counter-alert"
                role="alert"
              />
            </div>
          </div>
        </div>
        <div
          class="additional-instructions"
        >
          <div
            class="cds--form-item additional-instruction"
          >
            <div
              class="cds--text-area__label-wrapper"
            >
              <label
                class="cds--label cds--label--disabled"
                dir="auto"
              >
                Additional Instruction
              </label>
            </div>
            <div
              class="cds--text-area__wrapper cds--text-area__wrapper--readonly"
            >
              <textarea
                aria-invalid="false"
                aria-readonly="true"
                class="cds--text-area"
                disabled=""
                placeholder=""
                readonly=""
                rows="1"
                style="width: 100%;"
                type="text"
              />
              <span
                aria-atomic="true"
                aria-live="assertive"
                class="cds--text-area__counter-alert"
                role="alert"
              />
            </div>
          </div>
        </div>
        <div
          class="notes-sections"
        >
          <div
            class="cds--form-item notes-section"
          >
            <div
              class="cds--text-area__label-wrapper"
            >
              <label
                class="cds--label"
                dir="auto"
              >
                Notes
              </label>
            </div>
            <div
              class="cds--text-area__wrapper"
            >
              <textarea
                aria-invalid="false"
                class="cds--text-area"
                data-testid="notes-section"
                placeholder=""
                rows="3"
                style="width: 100%;"
                type="text"
              />
              <span
                aria-atomic="true"
                aria-live="assertive"
                class="cds--text-area__counter-alert"
                role="alert"
              />
            </div>
          </div>
        </div>
      </div>
      <div
        class="footer"
      >
        <button
          class="cancel-button-slider cds--btn cds--btn--secondary"
          data-testid="cancel"
          type="button"
        >
          <span>
            Cancel
          </span>
        </button>
        <button
          class="save-button-slider cds--btn cds--btn--primary"
          type="button"
        >
          Save
        </button>
      </div>
    </div>
  </div>
</div>
`;
